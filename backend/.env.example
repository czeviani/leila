ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SCRAPER_URL=http://scraper:8000
SCRAPER_SECRET=...
PORT=3001
NODE_ENV=production

# CORS — origens permitidas, separadas por vírgula
CORS_ORIGINS=https://leila-lemon.vercel.app

# OpenRouter e OpenAI — providers opcionais pra avaliação de investimento
# (evaluator.service.ts), selecionáveis em Configurações. Não são usados na
# leitura documental (pipeline v2 usa só Anthropic — ver document-agents/).
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Leitura documental — pipeline de 3 agentes (document-agents/). Os defaults
# já são os corretos; só sobrescreva para testar outro modelo.
DOCUMENT_EXTRACTOR_MODEL=claude-sonnet-5
DOCUMENT_LIABILITIES_MODEL=claude-opus-5
DOCUMENT_CONSOLIDATOR_MODEL=claude-sonnet-5

# Registro de custo (ai-usage.service.ts) — cotação usada para converter USD em BRL.
USD_BRL_RATE=5.40
